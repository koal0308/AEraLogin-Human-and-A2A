# AEra Agent Security Lab -- environment template
# Copy to .env and fill in. NEVER commit .env.
#
# Provider API keys are read from the environment only. They are NEVER sent to
# AEra, never written to a log and never included in an A2A payload. Likewise,
# AEra Agent JWTs and Ed25519 private keys are NEVER sent to an LLM provider.
#
# If a `.env` exists in the parent AEra directory, the variables below are
# imported from it automatically. Only the prefixes DEEPSEEK_ / XAI_ / GROK_ /
# ANTHROPIC_ / CLAUDE_ are importable -- no AEra secret can ever be picked up.

# --- AEra target -------------------------------------------------------------
AERA_BASE_URL=https://aeralogin.com

# --- xAI / Grok  (Agent A in run 1) ------------------------------------------
# Alias also accepted: GROK_API_KEY / GROK_BASE_URL / GROK_MODEL
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6

# --- DeepSeek  (Agent B in run 1) --------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Anthropic / Claude  (Agent C in run 1) ----------------------------------
# Alias also accepted: CLAUDE_API_KEY / CLAUDE_BASE_URL / CLAUDE_MODEL
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5

# --- Lab behaviour -----------------------------------------------------------
# mock | grok | deepseek | claude
LAB_PROVIDER=mock
# Timeout for AEra API calls (fast).
LAB_HTTP_TIMEOUT=60
# Separate, much larger budget for LLM calls. A long multi-agent review prompt
# can take several minutes; sharing the AEra timeout caused a ReadTimeout.
LAB_PROVIDER_TIMEOUT=600

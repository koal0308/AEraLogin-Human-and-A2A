# AEraLogIn Human & A2A — reference configuration
# Copy to .env and replace every placeholder with environment-specific values.
# Never commit .env, credentials, private keys or production databases.

# Server
ENV=development
HOST=127.0.0.1
PORT=8840
PUBLIC_URL=http://localhost:8840

# Database
DATABASE_PATH=./aera.db

# CORS
# Use explicit origins in production.
CORS_ORIGINS=http://localhost:8840

# Required authentication secrets
# Generate fresh random values; minimum length is 32 characters.
TOKEN_SECRET=REPLACE_WITH_RANDOM_SECRET
OAUTH_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
OAUTH_ADMIN_KEY=REPLACE_WITH_RANDOM_SECRET

# Token/session lifetime
TOKEN_EXPIRY_MINUTES=2
OAUTH_TOKEN_EXPIRY_HOURS=1

# Base / Web3 compatibility layer
BASE_RPC_URL=https://mainnet.base.org
BASE_ALCHEMY_API_URL=
BASE_NETWORK_CHAIN_ID=8453
BLOCKSCOUT_API_URL=https://base.blockscout.com/api/v2

# Contract addresses used by the historical Web3 compatibility layer.
# Replace with the addresses for the environment being tested.
IDENTITY_NFT_ADDRESS=0x0000000000000000000000000000000000000001
RESONANCE_SCORE_ADDRESS=0x0000000000000000000000000000000000000002
RESONANCE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000003

# Optional Web3/admin settings
ADMIN_WALLET=
ADMIN_PRIVATE_KEY=
BACKEND_PRIVATE_KEY=
PRIVATE_KEY=

# Optional community integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Optional public/community links
TELEGRAM_INVITE_LINK=
DISCORD_INVITE_LINK=

# Optional logging
LOG_LEVEL=INFO
